# Canonical origins of the two sites (same codebase, host-based routing in src/proxy.ts)
NEXT_PUBLIC_TR_ORIGIN=https://www.aresizolasyon.com
NEXT_PUBLIC_EN_ORIGIN=https://www.aresrefractory.com
# Hostnames that should be served the global (English) site. Leave empty on a single host (dev, preview) — then /en/ serves it.
GLOBAL_HOSTS=aresrefractory.com,www.aresrefractory.com
# Link prefix of the global site. "" on split domains (aresrefractory.com serves it at /), "/en" on a single host.
NEXT_PUBLIC_EN_PREFIX=

# "production" = only approved (published) content is indexable/visible.
# "preview"    = drafts visible with a banner, whole site noindex (client review / staging).
NEXT_PUBLIC_SITE_STAGE=preview

# Quote requests
QUOTE_STORAGE_DIR=./data/quotes
# Optional: every validated request is POSTed as JSON here (CRM / Make / n8n / HubSpot …)
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# Analytics (loaded only after cookie consent)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
